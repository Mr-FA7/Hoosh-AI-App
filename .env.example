# Hoosh AI — environment template
# Copy to `.env` / `.env.local` for local overrides. Do not commit real secrets.
# Firebase web config values identify the project; access is enforced by Auth + Security Rules.

# Optional API base override for the web UI
# VITE_API_BASE=

# Firebase client (web) — optional overrides
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=

# Local Runtime (companion) — examples only
# FA7_PORT=3001
# FA7_BIND=127.0.0.1
# FA7_DESKTOP_SHELL=1
# FA7_DESKTOP_TOKEN=
# FA7_ALLOW_BROWSER=0
