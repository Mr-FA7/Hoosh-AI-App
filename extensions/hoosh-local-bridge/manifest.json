{
  "manifest_version": 3,
  "name": "Hoosh Local Bridge",
  "version": "0.1.4",
  "description": "Connects aihoosh.com to Hoosh companion on your computer (files, terminal, Ollama, LM Studio).",
  "key": "",
  "permissions": ["storage"],
  "host_permissions": [
    "https://aihoosh.com/*",
    "https://www.aihoosh.com/*",
    "https://*.aihoosh.com/*",
    "http://127.0.0.1:3001/*",
    "http://localhost:3001/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://aihoosh.com/*",
        "https://www.aihoosh.com/*",
        "https://*.aihoosh.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["bridge-page.js"],
      "matches": [
        "https://aihoosh.com/*",
        "https://www.aihoosh.com/*",
        "https://*.aihoosh.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "Hoosh Local Bridge"
  }
}
