{
  "name": "fa7-os",
  "version": "1.0.0",
  "description": "Hoosh AI — local-first, model-agnostic agent platform (source-available; see LICENSE)",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Fardin Ahrari / Mr-FA7",
  "homepage": "https://aihoosh.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mr-FA7/Hoosh-AI-App.git"
  },
  "bugs": {
    "url": "https://github.com/Mr-FA7/Hoosh-AI-App/issues"
  },
  "main": "electron-main.js",
  "scripts": {
    "dev": "concurrently -n companion,vite -c blue,green \"nodemon companion.js\" \"vite\"",
    "companion": "nodemon companion.js",
    "companion:fresh": "FA7_PORT=3011 node companion.js",
    "bridge": "node companion.js",
    "bridge:pack": "node scripts/package-bridge-extension.mjs",
    "bridge:installer:win": "node scripts/build-bridge-windows-installer.mjs",
    "bridge:installer:mac": "node scripts/package-mac-app.mjs",
    "test:bridge:e2e": "node scripts/test-bridge-e2e.mjs",
    "test:bridge:user": "node scripts/test-bridge-user-like.mjs",
    "prebuild": "npm run bridge:pack",
    "start": "node server.js",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:start": "concurrently -n app,electron -c green,magenta \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder -c.npmRebuild=false",
    "electron:build:mac": "npm run build && electron-builder --mac -c.npmRebuild=false",
    "electron:build:win": "npm run build && electron-builder --win -c.npmRebuild=false",
    "electron:build:linux": "npm run build && electron-builder --linux -c.npmRebuild=false",
    "hoosh-cli": "node scripts/hoosh-cli.js",
    "test": "node scripts/test-security.js && node scripts/test-model-tiers.js",
    "test:security": "node scripts/test-security.js",
    "test:models": "node scripts/test-model-tiers.js",
    "smoke": "node scripts/smoke-test.js",
    "test:smoke-phase16": "node scripts/smoke-phase16.js",
    "media:setup": "node scripts/media-setup.js --force-recreate",
    "media:setup:stacks": "node scripts/media-setup.js --force-recreate --stacks",
    "media:status": "node scripts/media-setup.js --status",
    "desktop": "python3 desktop/main.py",
    "desktop:protect": "python3 scripts/protect_hoosh_desktop.py",
    "desktop:build": "npm run build && python3 scripts/protect_hoosh_desktop.py --plain-only && python3 -m PyInstaller --noconfirm --distpath dist_desktop --workpath build/pyinstaller-desktop desktop/Hoosh.spec",
    "desktop:package:mac": "node scripts/package-hoosh-desktop-mac.mjs",
    "desktop:package:win": "node scripts/package-hoosh-desktop-win.mjs",
    "desktop:ship": "npm run build && npm run desktop:protect && npm run desktop:package:mac && npm run desktop:package:win"
  },
  "build": {
    "appId": "com.fa7.os",
    "productName": "FA7 OS",
    "directories": {
      "output": "dist_electron"
    },
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hoosh AI"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Development",
      "maintainer": "FA7 Labs LTD <FA7_230@yahoo.com>",
      "synopsis": "Local-first AI software engineering environment",
      "desktop": {
        "entry": {
          "StartupWMClass": "FA7 OS"
        }
      },
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "companion.js",
      "kernel.js",
      "indexer.js",
      "ollamaManager.js",
      "systemHealth.js",
      "companionShellPty.js",
      "companionStudioDev.js",
      "companionOllamaPull.js",
      "companionOllamaApiProxy.js",
      "companionUatMount.js",
      "companionStacks.js",
      "companionFlows.js",
      "companionMedia.js",
      "lib/mediaBootstrap.js",
      "lib/mediaEnv.js",
      "lib/mediaInstall.js",
      "lib/mediaPipelines.js",
      "lib/mediaCatalog.js",
      "lib/mediaBridge.js",
      "lib/mediaAgentTools.js",
      "scripts/media-setup.js",
      "companionVmLab.js",
      "companionVmLabEmbeddedQemu.js",
      "companionOllamaRuntime.js",
      "companionOllamaRuntimeDownload.js",
      "companionFa7Plugins.js",
      "kavoshBrowserKernel.js",
      "giraBdtmKernel.js",
      "githubManager.js",
      "negahRunner.js",
      "composeBuildPipeline.js",
      "fa7-plugins/**/*",
      "electron-main.js",
      "preload.js",
      "package.json",
      "lib/**/*",
      "templates/**/*",
      "skills/**/*",
      "tools/**/*"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@monaco-editor/react": "^4.7.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.11.0",
    "acorn": "^8.17.0",
    "adm-zip": "^0.5.16",
    "autoprefixer": "^10.4.27",
    "axios": "^1.13.6",
    "body-parser": "^2.2.2",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "firebase": "^12.18.0",
    "framer-motion": "^12.38.0",
    "fs-extra": "^11.3.4",
    "lucide-react": "^1.6.0",
    "monaco-editor-textmate": "^4.0.0",
    "monaco-textmate": "^3.0.1",
    "ollama": "^0.6.3",
    "onigasm": "^2.2.5",
    "postcss": "^8.5.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.2.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "ws": "^8.20.0",
    "zustand": "^5.0.12"
  },
  "optionalDependencies": {
    "@lancedb/lancedb": "^0.30.0",
    "node-pty": "^1.1.0",
    "tree-sitter": "^0.21.1",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/fs-extra": "^11.0.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "electron": "^41.0.4",
    "electron-builder": "^26.8.1",
    "innosetup-compiler": "^6.3.1",
    "nodemon": "^3.1.14",
    "playwright": "^1.61.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.2",
    "wait-on": "^9.0.4"
  }
}
